{
  "name": "hexacore-agent",
  "version": "3.0.0",
  "description": "HexaCore Agent - governed Vertical Slice Architecture companion (MCP server + CLI) for 11 stacks",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/hexacore_cli.ts",
    "mcp": "tsx src/cli/mcp_launcher.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e_stack.mjs"
  },
  "keywords": [],
  "author": "HexaCore Architecture Team",
  "license": "MIT",
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "cross-spawn": "^7.0.6",
    "zod": "^4.4.3"
  },
  "bin": {
    "hexacore": "dist/cli/hexacore_cli.js",
    "hexacore-mcp": "dist/cli/mcp_launcher.js"
  },
  "files": [
    "dist",
    "docs/rules",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
